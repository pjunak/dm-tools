{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dmtools:schema:terrain-project:2",
  "title": "DM Tools terrain project version 2",
  "description": "Explicit opt-in to named stage seeds. All geography and authoring semantics remain as in version 1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "coastline",
    "settings",
    "constraints",
    "authoring"
  ],
  "properties": {
    "schema": {
      "$ref": "urn:dmtools:schema:terrain-project:1#/properties/schema"
    },
    "schema_version": {
      "const": 2
    },
    "coastline": {
      "$ref": "urn:dmtools:schema:terrain-project:1#/properties/coastline"
    },
    "settings": {
      "$ref": "#/$defs/generatorSettings"
    },
    "constraints": {
      "$ref": "urn:dmtools:schema:terrain-project:1#/properties/constraints"
    },
    "authoring": {
      "$ref": "urn:dmtools:schema:terrain-project:1#/properties/authoring"
    }
  },
  "$defs": {
    "generatorSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seed",
        "object_scale_km",
        "resolution_px",
        "maximum_elevation_m",
        "largest_feature_km",
        "detail_levels",
        "roughness",
        "coastal_rise_km",
        "variability",
        "seed_policy"
      ],
      "properties": {
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "object_scale_km": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "resolution_px": {
          "type": "integer",
          "minimum": 64,
          "maximum": 4096
        },
        "maximum_elevation_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "largest_feature_km": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "detail_levels": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "roughness": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "coastal_rise_km": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "variability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "seed_policy": {
          "const": "named-stage-sha256@1"
        }
      }
    }
  }
}
