{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dmtools:schema:terrain-project:1",
  "title": "DM Tools terrain project version 1",
  "description": "Authored inputs needed to reopen and regenerate one coastline terrain project.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "coastline",
    "settings",
    "constraints",
    "authoring"
  ],
  "properties": {
    "schema": {"const": "dmtools.terrain-project"},
    "schema_version": {"const": 1},
    "coastline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "SVG path, resolved relative to the project document unless absolute."
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Fingerprint of the exact authoritative SVG bytes."
        }
      }
    },
    "settings": {"$ref": "#/$defs/generatorSettings"},
    "constraints": {
      "type": "array",
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/heightPoint"},
          {"$ref": "#/$defs/terrainBrush"},
          {"$ref": "#/$defs/ridge"},
          {"$ref": "#/$defs/valley"}
        ]
      }
    },
    "authoring": {"$ref": "#/$defs/authoringState"}
  },
  "$defs": {
    "normalizedPoint": {
      "type": "array",
      "prefixItems": [
        {"type": "number", "minimum": 0, "maximum": 1},
        {"type": "number", "minimum": 0, "maximum": 1}
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "elevationMode": {
      "type": "string",
      "enum": ["absolute", "relative"]
    },
    "generatorSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seed",
        "object_scale_km",
        "resolution_px",
        "maximum_elevation_m",
        "largest_feature_km",
        "detail_levels",
        "roughness",
        "coastal_rise_km",
        "variability"
      ],
      "properties": {
        "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "object_scale_km": {"type": "number", "exclusiveMinimum": 0},
        "resolution_px": {"type": "integer", "minimum": 64, "maximum": 4096},
        "maximum_elevation_m": {"type": "number", "exclusiveMinimum": 0},
        "largest_feature_km": {"type": "number", "exclusiveMinimum": 0},
        "detail_levels": {"type": "integer", "minimum": 1, "maximum": 12},
        "roughness": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "coastal_rise_km": {"type": "number", "exclusiveMinimum": 0},
        "variability": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "heightPoint": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {"elevation_mode": {"const": "absolute"}},
            "required": ["elevation_mode"]
          },
          "then": {"properties": {"elevation_m": {"minimum": 0}}}
        }
      ],
      "required": [
        "type",
        "position",
        "elevation_mode",
        "elevation_m",
        "influence_radius_km"
      ],
      "properties": {
        "type": {"const": "height_point"},
        "position": {"$ref": "#/$defs/normalizedPoint"},
        "elevation_mode": {"$ref": "#/$defs/elevationMode"},
        "elevation_m": {"type": "number"},
        "influence_radius_km": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "terrainBrush": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {"elevation_mode": {"const": "absolute"}},
            "required": ["elevation_mode"]
          },
          "then": {"properties": {"elevation_m": {"minimum": 0}}}
        }
      ],
      "required": [
        "type",
        "points",
        "elevation_mode",
        "elevation_m",
        "influence_radius_km",
        "intensity"
      ],
      "properties": {
        "type": {"const": "terrain_brush"},
        "points": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/normalizedPoint"}
        },
        "elevation_mode": {"$ref": "#/$defs/elevationMode"},
        "elevation_m": {"type": "number"},
        "influence_radius_km": {"type": "number", "exclusiveMinimum": 0},
        "intensity": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
      }
    },
    "ridge": {"$ref": "#/$defs/structureRidge"},
    "valley": {"$ref": "#/$defs/structureValley"},
    "structureRidge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "points",
        "elevation_mode",
        "elevation_m",
        "influence_radius_km"
      ],
      "properties": {
        "type": {"const": "ridge"},
        "points": {
          "type": "array",
          "minItems": 2,
          "items": {"$ref": "#/$defs/normalizedPoint"}
        },
        "elevation_mode": {"$ref": "#/$defs/elevationMode"},
        "elevation_m": {"type": "number", "minimum": 0},
        "influence_radius_km": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "structureValley": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "points",
        "elevation_mode",
        "elevation_m",
        "influence_radius_km"
      ],
      "properties": {
        "type": {"const": "valley"},
        "points": {
          "type": "array",
          "minItems": 2,
          "description": "Ordered from the upstream valley head toward the downstream outlet.",
          "items": {"$ref": "#/$defs/normalizedPoint"}
        },
        "elevation_mode": {"$ref": "#/$defs/elevationMode"},
        "elevation_m": {
          "type": "number",
          "minimum": 0,
          "description": "Absolute mode uses the downstream outlet floor; relative mode uses preferred incision depth."
        },
        "influence_radius_km": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "featureToolSettings": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {"elevation_mode": {"const": "absolute"}},
            "required": ["elevation_mode"]
          },
          "then": {"properties": {"elevation_m": {"minimum": 0}}}
        }
      ],
      "required": ["elevation_mode", "elevation_m", "radius_km"],
      "properties": {
        "elevation_mode": {"$ref": "#/$defs/elevationMode"},
        "elevation_m": {"type": "number"},
        "radius_km": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "directionalFeatureToolSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["elevation_mode", "elevation_m", "radius_km"],
      "properties": {
        "elevation_mode": {"$ref": "#/$defs/elevationMode"},
        "elevation_m": {"type": "number", "minimum": 0},
        "radius_km": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "brushToolSettings": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {"elevation_mode": {"const": "absolute"}},
            "required": ["elevation_mode"]
          },
          "then": {"properties": {"elevation_m": {"minimum": 0}}}
        }
      ],
      "required": ["elevation_mode", "elevation_m", "width_km", "intensity"],
      "properties": {
        "elevation_mode": {"$ref": "#/$defs/elevationMode"},
        "elevation_m": {"type": "number"},
        "width_km": {"type": "number", "exclusiveMinimum": 0},
        "intensity": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
      }
    },
    "authoringState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active_tool", "tools"],
      "properties": {
        "active_tool": {
          "type": "string",
          "enum": ["brush", "height", "ridge", "valley"]
        },
        "tools": {
          "type": "object",
          "additionalProperties": false,
          "required": ["brush", "height", "ridge", "valley"],
          "properties": {
            "brush": {"$ref": "#/$defs/brushToolSettings"},
            "height": {"$ref": "#/$defs/featureToolSettings"},
            "ridge": {"$ref": "#/$defs/directionalFeatureToolSettings"},
            "valley": {"$ref": "#/$defs/directionalFeatureToolSettings"}
          }
        }
      }
    }
  }
}
